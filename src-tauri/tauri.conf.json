{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlayStation Cafe POS",
  "version": "0.1.0",
  "identifier": "com.playstationcafe.pos",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PlayStation Cafe POS",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420 ws://localhost:1421; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "publisher": "PlayStation Café",
    "copyright": "Unsigned development/pre-release until Authenticode-signed.",
    "shortDescription": "PlayStation Café POS + Timer",
    "longDescription": "Local-first PlayStation café POS. Unsigned NSIS builds are pre-release only.",
    "category": "Business",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
