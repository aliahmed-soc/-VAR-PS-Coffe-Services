# Development only. Never commit a real .env.
# Release builds reject loopback URLs and default the URL to the hosted project.
# Debug builds reject hosted *.supabase.co unless PSC_ALLOW_PROD=1
# (never set that on a cashier PC).
PSC_ENV=development
PSC_SUPABASE_URL=http://127.0.0.1:54321
PSC_SUPABASE_ANON_KEY=replace-with-local-anon-or-sb_publishable-key
# Production cashier PC (or CI compile-time):
# PSC_SUPABASE_URL=https://rbxtxtlssknjioaveytg.supabase.co
# PSC_SUPABASE_ANON_KEY=sb_publishable_...
# Never set a project secret (sb_secret_...), service-role, or JWT signing material.
