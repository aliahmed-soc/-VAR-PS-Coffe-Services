# Development only. Never commit a real .env.
# Release builds reject loopback URLs. Debug builds reject hosted *.supabase.co
# unless PSC_ALLOW_PROD=1 (never set that on a cashier PC).
PSC_ENV=development
PSC_SUPABASE_URL=http://127.0.0.1:54321
PSC_SUPABASE_ANON_KEY=replace-with-local-anon-key
# Never set SUPABASE_SERVICE_ROLE_KEY on a POS machine. Never package it.
